{
  "name": "souclaude-harness",
  "version": "3.19.0",
  "description": "CLI para inicializar y migrar el harness de Claude Code de SOUTEC",
  "type": "module",
  "bin": {
    "souclaude": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test --test-concurrency=1",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"scripts/**\" --test-coverage-include=\"bin/**\" --test-coverage-include=\"templates/**\" --test-coverage-include=\".claude/**\" --test-coverage-lines=89 --test-coverage-branches=79 --test-coverage-functions=90",
    "verify": "node bin/cli.mjs verify --strict",
    "docs:check": "node scripts/gen-docs-metodologia.mjs --check",
    "check": "npm run verify && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soutecdev/souclaude-harness.git"
  },
  "license": "UNLICENSED",
  "private": true
}
