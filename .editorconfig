# Convenciones del codigo de este repo, para que el editor las aplique solo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# En Markdown, dos espacios al final de una linea son un salto de linea.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
