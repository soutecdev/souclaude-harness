{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/declarar-milestone.mjs",
            "statusMessage": "Leyendo el tablero del Vault...",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reglas-pr.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/reglas-pr.mjs",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
