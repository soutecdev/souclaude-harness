{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.json)",
      "Read(./**/id_rsa*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * *:main*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release:*)",
      "Bash(git -C * push * main*)",
      "Bash(git -C * push * *:main*)"
    ],
    "allow": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git -C * add:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * pull:*)",
      "Bash(git -C * push:*)",
      "Bash(git -C * status:*)",
      "Bash(git -C * fetch:*)",
      "Bash(git -C * log:*)",
      "Bash(git -C * diff:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git -C * push*--force*)",
      "Bash(git -C * push* -f*)",
      "Bash(git -C * push * +*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/declarar-milestone.mjs"
          }
        ]
      }
    ]
  }
}
